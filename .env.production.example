##############################################################
# OCTAVIA TECH SOLUTIONS — PRODUCTION ENVIRONMENT TEMPLATE
# Namecheap Stellar Shared Hosting
# Phase 4 — Production Readiness Configuration
#
# INSTRUCTIONS:
#  1. Copy this file to .env on the production server
#  2. Fill in ALL values marked [REQUIRED]
#  3. Generate APP_KEY with: php artisan key:generate
#  4. NEVER commit the actual .env file to version control
#  5. Store production .env in a secure secrets manager
##############################################################

# ──────────────────────────────────────────────────────────
# APPLICATION
# ──────────────────────────────────────────────────────────
APP_NAME="Octavia Tech Solutions"
APP_ENV=production
APP_KEY=                          # [REQUIRED] Run: php artisan key:generate
APP_DEBUG=false                   # MUST be false in production
APP_URL=https://octaviatechnologies.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ──────────────────────────────────────────────────────────
# MAINTENANCE MODE
# ──────────────────────────────────────────────────────────
APP_MAINTENANCE_DRIVER=file

# ──────────────────────────────────────────────────────────
# SECURITY
# ──────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12                  # Do not reduce below 10

# ──────────────────────────────────────────────────────────
# LOGGING
# ──────────────────────────────────────────────────────────
LOG_CHANNEL=daily                 # Use 'daily' for production (auto-rotates)
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                   # Only log errors in production (not debug)

# ──────────────────────────────────────────────────────────
# DATABASE — MySQL/MariaDB (Namecheap cPanel)
# ──────────────────────────────────────────────────────────
DB_CONNECTION=mysql               # [REQUIRED]
DB_HOST=127.0.0.1                 # [REQUIRED] Usually 127.0.0.1 on shared hosting
DB_PORT=3306
DB_DATABASE=                      # [REQUIRED] Your cPanel MySQL database name
DB_USERNAME=                      # [REQUIRED] Your cPanel MySQL database username
DB_PASSWORD=                      # [REQUIRED] Your cPanel MySQL database password

# ──────────────────────────────────────────────────────────
# SESSION
# ──────────────────────────────────────────────────────────
SESSION_DRIVER=database           # Use 'database' for persistence across requests
SESSION_LIFETIME=120              # Minutes before session expires
SESSION_ENCRYPT=true              # [RECOMMENDED] Encrypt session data at rest
SESSION_PATH=/
SESSION_DOMAIN=octaviatechnologies.com
SESSION_SECURE_COOKIE=true        # [REQUIRED] Only send session cookie over HTTPS
SESSION_HTTP_ONLY=true            # Prevent JavaScript access to session cookie
SESSION_SAME_SITE=lax             # CSRF protection

# ──────────────────────────────────────────────────────────
# CACHE
# ──────────────────────────────────────────────────────────
CACHE_STORE=database              # Use 'file' if DB cache table is unavailable
CACHE_PREFIX=octavia_

# ──────────────────────────────────────────────────────────
# QUEUE
# ──────────────────────────────────────────────────────────
QUEUE_CONNECTION=database         # Use 'sync' if no cron/worker available on shared hosting
# NOTE: Namecheap Stellar shared hosting has limited cron support.
# If queues are not needed, set QUEUE_CONNECTION=sync

# ──────────────────────────────────────────────────────────
# BROADCAST
# ──────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log

# ──────────────────────────────────────────────────────────
# FILESYSTEM
# ──────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ──────────────────────────────────────────────────────────
# MAIL — Configure SMTP for lead notification emails
# ──────────────────────────────────────────────────────────
# Options:
#   smtp       — Use an SMTP provider (SendGrid, Mailgun, Namecheap Mail, etc.)
#   ses        — Amazon SES
#   log        — Development only — logs email to storage/logs (DO NOT use in production)
#
# For Namecheap Stellar:
#   MAIL_MAILER=smtp
#   MAIL_HOST=mail.octaviatechnologies.com
#   MAIL_PORT=587
#   MAIL_ENCRYPTION=tls
#   MAIL_USERNAME=your-cpanel-email@octaviatechnologies.com
#   MAIL_PASSWORD=your-cpanel-email-password
#
# For SendGrid:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.sendgrid.net
#   MAIL_PORT=587
#   MAIL_ENCRYPTION=tls
#   MAIL_USERNAME=apikey
#   MAIL_PASSWORD=your-sendgrid-api-key

MAIL_MAILER=smtp                  # [REQUIRED] Change from 'log' to 'smtp'
MAIL_SCHEME=tls
MAIL_HOST=                        # [REQUIRED] Your SMTP host
MAIL_PORT=587
MAIL_USERNAME=                    # [REQUIRED] Your SMTP username
MAIL_PASSWORD=                    # [REQUIRED] Your SMTP password
MAIL_FROM_ADDRESS=noreply@octaviatechnologies.com
MAIL_FROM_NAME="Octavia Tech Solutions"

# ──────────────────────────────────────────────────────────
# VITE (Build-time only — not needed at runtime on server)
# ──────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
